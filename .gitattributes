# Tüm metin dosyaları depoda LF satır sonuyla saklanır.
* text=auto eol=lf

*.c      text diff=cpp
*.h      text diff=cpp
*.py     text diff=python
*.js     text
*.mjs    text
*.html   text diff=html
*.md     text diff=markdown
*.sh     text eol=lf
Makefile text eol=lf

# Üretilmiş test dosyaları: python tests/gen_vectors.py
tests/test_sha256.c linguist-generated=true
tests/test_chacha20.c linguist-generated=true

# Test örnek dosyaları bayt bayt korunur (satır sonu dönüşümü yok).
tests/data/* -text
